{
  "name": "whatshell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run start --prefix store_api",
    "build": "npm install --prefix store_api",
    "dev": "concurrently -n \"API,CLIENT\" -c \"blue.bold,magenta.bold\" \"npm run dev --prefix store_api\" \"npm run dev --prefix landing_page\"",
    "dev:api": "npm run dev --prefix store_api",
    "dev:client": "npm run dev --prefix landing_page",
    "start:api": "npm run start --prefix store_api",
    "start:client": "npm run dev --prefix landing_page",
    "build:client": "npm run build --prefix landing_page"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^181.0.0",
    "mongoose": "^9.10.1"
  }
}
