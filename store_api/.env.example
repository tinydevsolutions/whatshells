# Whatshells Store API Configuration

PORT=5000
NODE_ENV=development

# Brand Info
STORE_NAME=Whatshells
INSTAGRAM_HANDLE=@whatshells
WHATSAPP_PHONE=919876543210

# WhatsApp Cloud API Webhook Token (Optional)
WHATSAPP_VERIFY_TOKEN=own_verify_token

# Google Sheets Integration (Option 1: Service Account via googleapis)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""

# Google Sheets Integration (Option 2: Google Apps Script Webhook URL)
GOOGLE_SHEET_WEBHOOK_URL=

# MongoDB Connection (Optional: defaults to persistent JSON store)
MONGODB_URI=mongo_url
